{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "24e6042f-139a-48f7-b9ff-ad09b17d1bb0"
  },
  "newProjectRoot": "projects",
  "projects": {
    "Resta": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
             "allowedHosts": ["192.168.88.14"]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
              {
  "type": "initial",
  "maximumWarning": "600kB",
  "maximumError": "1.2MB"
},
                {
                  "type": "initial",
                  "maximumWarning": "1.5mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
      "serve": {
  "builder": "@angular/build:dev-server",
  "options": {
    "allowedHosts": ["192.168.88.14"]
  },
  "configurations": {
    "production": {
      "buildTarget": "Resta:build:production"
    },
    "development": {
      "buildTarget": "Resta:build:development"
    }
  },
  "defaultConfiguration": "development"
},
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}